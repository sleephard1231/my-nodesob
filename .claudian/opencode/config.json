{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {},
    "claudian-inline-edit": {
      "description": "Claudian read-only execution agent.",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "codesearch": "allow",
        "external_directory": "deny",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "claudian-title": {
      "description": "Claudian passive execution agent.",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "external_directory": "deny"
      }
    },
    "plan": {
      "disable": true
    }
  },
  "default_agent": "build"
}
